@model HotelBookingSystem.Models.ViewModels.SearchViewModel
@{
    ViewData["Title"] = "Tìm Phòng & Homestay - Kiểm Tra Phòng Trống Trực Tuyến";
    var totalNights = Math.Max(1, (Model.CheckOutDate.Date - Model.CheckInDate.Date).Days);
}

<div class="bg-emerald text-white py-4 mb-4">
    <div class="container">
        <h2 class="fw-bold mb-1">
            <i class="bi bi-search me-2"></i>Tìm Kiếm &amp; Kiểm Tra Phòng Trống
        </h2>
        <p class="text-light opacity-90 mb-0 small">
            Dữ liệu phòng trống được cập nhật theo thời gian thực từ hệ thống quản lý khách sạn
        </p>
    </div>
</div>

<div class="container pb-5">
    <!-- Filter bar -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <form asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-lg-3 col-md-6">
                    <label class="form-label fw-bold small text-muted">Khu vực / Thành phố</label>
                    <select name="City" class="form-select">
                        <option value="">Tất cả điểm đến</option>
                        @foreach (var c in Model.AvailableCities)
                        {
                            <option value="@c" selected="@(Model.City == c ? "selected" : null)">@c</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-bold small text-muted">Ngày nhận phòng</label>
                    <input type="date" name="CheckInDate" class="form-control" 
                           value="@Model.CheckInDate.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-bold small text-muted">Ngày trả phòng</label>
                    <input type="date" name="CheckOutDate" class="form-control" 
                           value="@Model.CheckOutDate.ToString("yyyy-MM-dd")" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-bold small text-muted">Số lượng khách</label>
                    <select name="Guests" class="form-select">
                        <option value="1" selected="@(Model.Guests == 1 ? "selected" : null)">1 khách</option>
                        <option value="2" selected="@(Model.Guests == 2 ? "selected" : null)">2 khách</option>
                        <option value="3" selected="@(Model.Guests == 3 ? "selected" : null)">3 khách</option>
                        <option value="4" selected="@(Model.Guests == 4 ? "selected" : null)">4 khách</option>
                        <option value="5" selected="@(Model.Guests >= 5 ? "selected" : null)">5+ khách</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-bold small text-muted">Sắp xếp theo</label>
                    <select name="SortBy" class="form-select">
                        <option value="price_asc" selected="@(Model.SortBy == "price_asc" ? "selected" : null)">Giá thấp đến cao</option>
                        <option value="price_desc" selected="@(Model.SortBy == "price_desc" ? "selected" : null)">Giá cao đến thấp</option>
                        <option value="capacity" selected="@(Model.SortBy == "capacity" ? "selected" : null)">Sức chứa lớn nhất</option>
                    </select>
                </div>
                <div class="col-lg-1 col-md-12 d-flex align-items-end">
                    <button type="submit" class="btn btn-emerald w-100 fw-bold" title="Lọc kết quả">
                        <i class="bi bi-funnel-fill"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Active Search Info Summary -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h5 class="fw-bold mb-1">
                Tìm thấy <span class="text-emerald">@Model.Results.Count</span> loại phòng khả dụng
            </h5>
            <div class="small text-muted">
                <i class="bi bi-calendar3 me-1"></i>Từ <strong>@Model.CheckInDate.ToString("dd/MM/yyyy")</strong> đến <strong>@Model.CheckOutDate.ToString("dd/MM/yyyy")</strong> (@totalNights đêm)
                @if (!string.IsNullOrEmpty(Model.City))
                {
                    <span class="ms-2 badge bg-light text-dark border"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@Model.City</span>
                }
            </div>
        </div>
        <div class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill small">
            <i class="bi bi-broadcast me-1"></i>Trạng thái thời gian thực
        </div>
    </div>

    <!-- Results List -->
    @if (!Model.Results.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body">
                <div class="display-1 text-muted mb-3"><i class="bi bi-calendar-x"></i></div>
                <h4 class="fw-bold text-dark">Không tìm thấy phòng trống phù hợp</h4>
                <p class="text-muted mx-auto" style="max-width: 500px;">
                    Các phòng tại khu vực này đã kín chỗ trong khoảng ngày bạn chọn. Vui lòng thử đổi ngày nhận/trả phòng hoặc chọn điểm đến khác.
                </p>
                <a href="/Rooms" class="btn btn-emerald rounded-pill px-4 fw-bold">
                    <i class="bi bi-arrow-clockwise me-1"></i>Xem tất cả phòng
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var room in Model.Results)
            {
                <div class="col-12">
                    <div class="card border-0 rounded-4 shadow-sm overflow-hidden card-hover">
                        <div class="row g-0">
                            <!-- Image Column -->
                            <div class="col-md-4 position-relative">
                                <img src="@room.ImageUrl" class="w-100 h-100 object-fit-cover" style="min-height: 240px; max-height: 280px;" alt="@room.RoomTypeName" />
                                <span class="position-absolute top-0 start-0 m-3 badge bg-dark bg-opacity-75 rounded-pill px-3 py-2 small">
                                    <i class="bi bi-geo-alt-fill text-warning me-1"></i>@room.City
                                </span>
                            </div>

                            <!-- Content Column -->
                            <div class="col-md-5 p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="text-warning small">
                                            @for (int i = 0; i < room.StarRating; i++)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                        </span>
                                        <span class="text-muted small">| @room.HotelName</span>
                                    </div>
                                    <h4 class="fw-bold text-dark mb-2">@room.RoomTypeName</h4>
                                    <p class="small text-muted mb-2">
                                        <i class="bi bi-pin-map-fill text-danger me-1"></i>@room.Address
                                    </p>

                                    <!-- Specs -->
                                    <div class="d-flex flex-wrap gap-2 my-2 text-secondary small">
                                        <span class="badge bg-light text-dark border"><i class="bi bi-people me-1"></i>Tối đa @room.Capacity khách</span>
                                        <span class="badge bg-light text-dark border"><i class="bi bi-aspect-ratio me-1"></i>@room.SizeM2 m²</span>
                                        <span class="badge bg-light text-dark border"><i class="bi bi-moon me-1"></i>@room.BedType</span>
                                    </div>

                                    <!-- Amenities -->
                                    <div class="small text-muted mt-2">
                                        <i class="bi bi-check2-circle text-success me-1"></i>@room.Amenities
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <span class="badge bg-emerald-light text-emerald px-3 py-1 rounded-pill small fw-bold">
                                        <i class="bi bi-check-circle-fill me-1"></i>Còn @room.AvailableRoomsCount phòng trống tức thì
                                    </span>
                                </div>
                            </div>

                            <!-- Pricing & Action Column -->
                            <div class="col-md-3 bg-light p-4 d-flex flex-column justify-content-between border-start">
                                <div class="text-end">
                                    <span class="badge bg-warning text-dark mb-2">Giá tốt hôm nay</span>
                                    <div class="small text-muted">Giá mỗi đêm</div>
                                    <div class="fs-4 fw-bold text-dark">
                                        @room.BasePrice.ToString("N0") <span class="small fw-normal text-muted">đ</span>
                                    </div>
                                    <div class="border-top pt-2 mt-2">
                                        <div class="small text-muted">Tổng (@totalNights đêm):</div>
                                        <div class="fs-4 fw-extrabold text-emerald">
                                            @room.TotalPriceForStay.ToString("N0") <span class="small fw-bold">đ</span>
                                        </div>
                                        <div class="small text-muted" style="font-size: 11px;">Đã bao gồm thuế &amp; phí</div>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <a asp-action="Details" asp-route-id="@room.RoomTypeId"
                                       asp-route-checkIn="@Model.CheckInDate.ToString("yyyy-MM-dd")"
                                       asp-route-checkOut="@Model.CheckOutDate.ToString("yyyy-MM-dd")"
                                       asp-route-guests="@Model.Guests"
                                       class="btn btn-emerald w-100 fw-bold rounded-pill py-2 shadow-sm">
                                        Đặt Phòng Ngay <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
