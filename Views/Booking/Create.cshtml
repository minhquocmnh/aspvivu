@model HotelBookingSystem.Models.ViewModels.BookingCreateViewModel
@{
    ViewData["Title"] = "Đặt Phòng - " + Model.RoomType?.Name;
}

<div class="bg-light py-4 border-bottom mb-4">
    <div class="container">
        <div class="d-flex align-items-center gap-2 small text-muted mb-1">
            <span>1. Chọn phòng</span>
            <i class="bi bi-chevron-right"></i>
            <span class="text-emerald fw-bold">2. Nhập thông tin &amp; Dịch vụ đi kèm</span>
            <i class="bi bi-chevron-right"></i>
            <span>3. Thanh toán &amp; Xác nhận</span>
        </div>
        <h2 class="fw-bold mb-0">Hoàn Tất Đặt Phòng &amp; Chọn Dịch Vụ</h2>
    </div>
</div>

<div class="container pb-5">
    <form asp-action="Create" method="post" id="bookingForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="RoomTypeId" />
        <input type="hidden" asp-for="SelectedRoomId" />
        <input type="hidden" asp-for="CheckInDate" />
        <input type="hidden" asp-for="CheckOutDate" />
        <input type="hidden" asp-for="GuestsCount" />

        <div class="row g-5">
            <!-- Left Form: Guest Info & Extra Services & Payment Method -->
            <div class="col-lg-7">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                <!-- 1. Guest Information -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2 text-dark">
                        <i class="bi bi-person-lines-fill text-emerald"></i>
                        <span>1. Thông Tin Khách Hàng Lưu Trú</span>
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="CustomerName" class="form-label fw-semibold small">Họ và tên người nhận phòng *</label>
                            <input asp-for="CustomerName" class="form-control" placeholder="Ví dụ: Nguyễn Văn An" required />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CustomerPhone" class="form-label fw-semibold small">Số điện thoại liên hệ *</label>
                            <input asp-for="CustomerPhone" class="form-control" placeholder="Ví dụ: 0912345678" required />
                            <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CustomerEmail" class="form-label fw-semibold small">Địa chỉ Email (Nhận mã xác nhận) *</label>
                            <input asp-for="CustomerEmail" type="email" class="form-control" placeholder="email@example.com" required />
                            <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="SpecialRequests" class="form-label fw-semibold small">Yêu cầu đặc biệt (Không bắt buộc)</label>
                            <textarea asp-for="SpecialRequests" class="form-control" rows="2" placeholder="Ví dụ: Tầng cao, nhận phòng sớm, chuẩn bị hoa sinh nhật, nôi cho em bé..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- 2. Extra Services Selection (Dịch vụ đi kèm) -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0 d-flex align-items-center gap-2 text-dark">
                            <i class="bi bi-stars text-warning"></i>
                            <span>2. Dịch Vụ Đi Kèm Tiện Ích</span>
                        </h5>
                        <span class="badge bg-warning-subtle text-dark border">Tùy chọn</span>
                    </div>
                    <p class="small text-muted mb-3">
                        Chọn thêm các dịch vụ bổ sung để chuyến đi của bạn thêm phần trọn vẹn. Giá sẽ tự động cộng vào tổng đơn:
                    </p>

                    <div class="row g-3">
                        @for (int i = 0; i < Model.AvailableServices.Count; i++)
                        {
                            var s = Model.AvailableServices[i];
                            <div class="col-12">
                                <div class="border rounded-3 p-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 service-item bg-white" data-service-id="@s.Id" data-price="@s.Price">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="form-check m-0">
                                            <input class="form-check-input service-checkbox fs-5" type="checkbox" 
                                                   name="SelectedServiceIds" value="@s.Id" id="srv_@s.Id" />
                                        </div>
                                        <div class="fs-3 text-emerald"><i class="bi @s.Icon"></i></div>
                                        <div>
                                            <label class="form-check-label fw-bold text-dark d-block" for="srv_@s.Id">
                                                @s.Name
                                            </label>
                                            <div class="small text-muted">@s.Description</div>
                                            <div class="small text-emerald fw-semibold">
                                                @s.Price.ToString("N0") đ / @s.Unit
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Quantity selector -->
                                    <div class="d-flex align-items-center gap-2 ms-auto">
                                        <span class="small text-muted">Số lượng:</span>
                                        <input type="number" name="ServiceQuantities[@s.Id]" value="1" min="1" max="20" 
                                               class="form-control form-control-sm text-center service-qty" style="width: 70px;" disabled />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- 3. Payment Method Selection -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2 text-dark">
                        <i class="bi bi-wallet2 text-primary"></i>
                        <span>3. Phương Thức Thanh Toán</span>
                    </h5>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="border rounded-3 p-3 w-100 cursor-pointer payment-option active d-flex flex-column align-items-center text-center">
                                <input type="radio" asp-for="PaymentMethod" value="VietQR" class="d-none" checked />
                                <i class="bi bi-qr-code-scan fs-2 text-success mb-2"></i>
                                <span class="fw-bold small">Quét mã VietQR</span>
                                <span class="text-muted small" style="font-size: 11px;">Mọi app ngân hàng</span>
                            </label>
                        </div>
                        <div class="col-md-4">
                            <label class="border rounded-3 p-3 w-100 cursor-pointer payment-option d-flex flex-column align-items-center text-center">
                                <input type="radio" asp-for="PaymentMethod" value="VNPay" class="d-none" />
                                <i class="bi bi-credit-card-2-front fs-2 text-primary mb-2"></i>
                                <span class="fw-bold small">Cổng VNPay</span>
                                <span class="text-muted small" style="font-size: 11px;">ATM / Visa / QR</span>
                            </label>
                        </div>
                        <div class="col-md-4">
                            <label class="border rounded-3 p-3 w-100 cursor-pointer payment-option d-flex flex-column align-items-center text-center">
                                <input type="radio" asp-for="PaymentMethod" value="Cash" class="d-none" />
                                <i class="bi bi-cash-stack fs-2 text-warning mb-2"></i>
                                <span class="fw-bold small">Tiền mặt tại KS</span>
                                <span class="text-muted small" style="font-size: 11px;">Khi nhận phòng</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="d-none d-lg-block">
                    <button type="submit" class="btn btn-emerald btn-lg w-100 fw-bold rounded-pill py-3 shadow">
                        <i class="bi bi-check-circle-fill me-2"></i>Xác Nhận &amp; Đặt Phòng Ngay
                    </button>
                </div>
            </div>

            <!-- Right Summary Box -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 90px;">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Tóm Tắt Đơn Đặt Phòng</h5>

                    <!-- Room Mini Card -->
                    <div class="d-flex gap-3 mb-3">
                        <img src="@Model.RoomType?.ImageUrl" class="rounded-3 object-fit-cover" style="width: 100px; height: 80px;" alt="@Model.RoomType?.Name" />
                        <div>
                            <div class="small text-muted">@Model.Hotel?.Name</div>
                            <h6 class="fw-bold text-dark mb-1">@Model.RoomType?.Name</h6>
                            <div class="small text-muted"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@Model.Hotel?.City</div>
                        </div>
                    </div>

                    <div class="bg-light rounded-3 p-3 mb-3 small">
                        <div class="row g-2">
                            <div class="col-6">
                                <span class="text-muted d-block">Nhận phòng:</span>
                                <strong class="text-dark">@Model.CheckInDate.ToString("dd/MM/yyyy") (14:00)</strong>
                            </div>
                            <div class="col-6">
                                <span class="text-muted d-block">Trả phòng:</span>
                                <strong class="text-dark">@Model.CheckOutDate.ToString("dd/MM/yyyy") (12:00)</strong>
                            </div>
                            <div class="col-6 mt-2">
                                <span class="text-muted d-block">Thời gian ở:</span>
                                <strong class="text-emerald">@Model.TotalNights đêm</strong>
                            </div>
                            <div class="col-6 mt-2">
                                <span class="text-muted d-block">Số lượng khách:</span>
                                <strong>@Model.GuestsCount khách</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Price Calculations -->
                    <div class="small mb-3">
                        <div class="d-flex justify-content-between text-secondary mb-1">
                            <span>Tiền phòng (@Model.TotalNights đêm):</span>
                            <span id="displayRoomCost" class="fw-semibold">@Model.RoomTotalCost.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between text-secondary mb-1">
                            <span>Dịch vụ đi kèm:</span>
                            <span id="displayServicesCost" class="fw-semibold text-warning">0 đ</span>
                        </div>
                        <div class="d-flex justify-content-between text-secondary mb-1">
                            <span>Phí dịch vụ khách sạn:</span>
                            <span class="text-success fw-semibold">Miễn phí</span>
                        </div>
                        <hr class="my-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fs-6 fw-bold text-dark d-block">Tổng tiền thanh toán:</span>
                                <span class="text-muted small" style="font-size: 11px;">Đã bao gồm VAT &amp; phí</span>
                            </div>
                            <div class="text-end">
                                <span id="displayGrandTotal" class="fs-4 fw-extrabold text-emerald">
                                    @Model.RoomTotalCost.ToString("N0") đ
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="d-lg-none mt-3">
                        <button type="submit" class="btn btn-emerald btn-lg w-100 fw-bold rounded-pill py-3 shadow">
                            <i class="bi bi-check-circle-fill me-2"></i>Xác Nhận &amp; Đặt Phòng
                        </button>
                    </div>

                    <div class="mt-3 p-3 bg-success-subtle rounded-3 small text-success">
                        <i class="bi bi-shield-lock-fill me-1"></i>Thông tin đặt phòng được bảo mật và xác nhận ngay lập tức qua hệ thống.
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            const roomTotalCost = @Model.RoomTotalCost;

            function calculateTotals() {
                let servicesTotal = 0;

                $('.service-item').each(function () {
                    const checkbox = $(this).find('.service-checkbox');
                    const qtyInput = $(this).find('.service-qty');
                    const price = parseFloat($(this).data('price'));

                    if (checkbox.is(':checked')) {
                        qtyInput.prop('disabled', false);
                        const qty = parseInt(qtyInput.val()) || 1;
                        servicesTotal += price * qty;
                    } else {
                        qtyInput.prop('disabled', true);
                    }
                });

                const grandTotal = roomTotalCost + servicesTotal;

                $('#displayServicesCost').text(servicesTotal.toLocaleString('vi-VN') + ' đ');
                $('#displayGrandTotal').text(grandTotal.toLocaleString('vi-VN') + ' đ');
            }

            $('.service-checkbox, .service-qty').on('change input', calculateTotals);

            // Payment radio cards visual styling
            $('input[name="PaymentMethod"]').on('change', function () {
                $('.payment-option').removeClass('active border-success bg-light');
                $(this).closest('.payment-option').addClass('active border-success bg-light');
            });

            // Trigger initial
            $('input[name="PaymentMethod"]:checked').closest('.payment-option').addClass('border-success bg-light');
        });
    </script>
}
