<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ Thống Đặt Phòng Khách Sạn & Homestay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="sticky-top bg-white border-bottom shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-light py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-success fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-buildings-fill fs-3 text-emerald"></i>
                    <span>StayVivu<span class="text-warning">.vn</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-medium">
                        <li class="nav-item">
                            <a class="nav-link text-dark px-3" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i>Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark px-3" asp-area="" asp-controller="Rooms" asp-action="Index">
                                <i class="bi bi-search me-1"></i>Tìm phòng & Homestay
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark px-3" asp-area="" asp-controller="Booking" asp-action="Lookup">
                                <i class="bi bi-ticket-perforated me-1"></i>Tra cứu đơn đặt
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark px-3" asp-area="" asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle me-1"></i>Giới thiệu
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="btn btn-outline-success btn-sm rounded-pill fw-semibold px-3" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-1"></i>Trang Quản Trị KS
                                    </a>
                                </li>
                            }
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-dark fw-medium" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="avatar-circle">
                                        <i class="bi bi-person-fill"></i>
                                    </span>
                                    <span>@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2" aria-labelledby="userDropdown">
                                    <li><h6 class="dropdown-header">Tài khoản: @User.Identity.Name</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Booking" asp-action="Lookup">
                                            <i class="bi bi-clock-history me-2"></i>Lịch sử đặt phòng
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item text-success fw-semibold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-shield-lock me-2"></i>Quản trị hệ thống
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger rounded-2">
                                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-light btn-sm fw-semibold px-3 rounded-pill" asp-area="" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-emerald btn-sm text-white fw-semibold px-3 rounded-pill shadow-sm" asp-area="" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i>Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm rounded-3" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm rounded-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <main role="main">
        @RenderBody()
    </main>

    <footer class="bg-dark text-light pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="fw-bold text-success mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-buildings-fill text-emerald"></i>
                        <span>StayVivu<span class="text-warning">.vn</span></span>
                    </h5>
                    <p class="text-secondary small mb-3">
                        Nền tảng đặt phòng khách sạn, resort và homestay cao cấp hàng đầu Việt Nam. Cam kết phòng chuẩn, kiểm tra phòng trống theo thời gian thực và thanh toán bảo mật tức thì.
                    </p>
                    <div class="d-flex gap-3 text-secondary">
                        <span class="badge bg-secondary p-2"><i class="bi bi-shield-check me-1 text-warning"></i>Bảo mật SSL</span>
                        <span class="badge bg-secondary p-2"><i class="bi bi-lightning-charge me-1 text-info"></i>Xác nhận tức thì</span>
                        <span class="badge bg-secondary p-2"><i class="bi bi-qr-code-scan me-1 text-success"></i>VietQR 24/7</span>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="fw-bold text-white mb-3">Điểm đến hot</h6>
                    <ul class="list-unstyled small text-secondary">
                        <li class="mb-2"><a href="/Rooms?City=Đà+Lạt" class="text-decoration-none text-secondary hover-white">Đà Lạt mộng mơ</a></li>
                        <li class="mb-2"><a href="/Rooms?City=Phú+Quốc" class="text-decoration-none text-secondary hover-white">Phú Quốc đảo ngọc</a></li>
                        <li class="mb-2"><a href="/Rooms?City=Đà+Nẵng" class="text-decoration-none text-secondary hover-white">Đà Nẵng biển xanh</a></li>
                        <li class="mb-2"><a href="/Rooms?City=Hà+Nội" class="text-decoration-none text-secondary hover-white">Hà Nội 36 phố phường</a></li>
                        <li class="mb-2"><a href="/Rooms?City=Sa+Pa" class="text-decoration-none text-secondary hover-white">Sa Pa săn mây</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="fw-bold text-white mb-3">Hỗ trợ & Tra cứu</h6>
                    <ul class="list-unstyled small text-secondary">
                        <li class="mb-2"><a asp-area="" asp-controller="Booking" asp-action="Lookup" class="text-decoration-none text-secondary hover-white">Kiểm tra đơn đặt phòng</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="About" class="text-decoration-none text-secondary hover-white">Chính sách hủy phòng</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="About" class="text-decoration-none text-secondary hover-white">Quy định dịch vụ</a></li>
                        <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Contact" class="text-decoration-none text-secondary hover-white">Liên hệ trợ giúp</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="fw-bold text-white mb-3">Dành cho chủ khách sạn & Homestay</h6>
                    <p class="text-secondary small mb-3">
                        Bạn là chủ khách sạn hoặc homestay? Đăng nhập vào trang quản trị để quản lý sơ đồ phòng, dịch vụ, đơn đặt và thống kê doanh thu.
                    </p>
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        <i class="bi bi-speedometer2 me-1"></i>Trang Quản Trị Chủ Khách Sạn
                    </a>
                    <div class="mt-3 small text-muted">
                        Tài khoản mẫu: <code>admin@hotel.com</code> / <code>Admin@123456</code>
                    </div>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-secondary">
                <div>&copy; 2026 StayVivu.vn - Dự án ASP.NET Core MVC Quản Lý & Đặt Phòng Khách Sạn / Homestay.</div>
                <div class="mt-2 mt-md-0">
                    Phát triển với ASP.NET Core &amp; Entity Framework Core
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
