@model List<HotelBookingSystem.Models.Booking>
@{
    ViewData["Title"] = "Quản Lý Đơn Đặt Phòng";
    var currentStatus = ViewBag.CurrentStatus as string;
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-calendar2-check-fill text-emerald me-2"></i>Quản Lý Đơn Đặt Phòng
        </h1>
        <p class="text-muted small mb-0">Theo dõi toàn bộ đơn đặt phòng, tiến độ lưu trú, thanh toán và dịch vụ đi kèm</p>
    </div>
</div>

<!-- Status Filter Tabs -->
<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a class="nav-link rounded-pill @(string.IsNullOrEmpty(currentStatus) ? "active bg-emerald" : "bg-white text-dark border")" asp-action="Index">
            Tất cả đơn (@Model.Count)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill @(currentStatus == "Pending" ? "active bg-warning text-dark" : "bg-white text-dark border")" asp-action="Index" asp-route-status="Pending">
            <i class="bi bi-hourglass-split me-1"></i>Chờ xác nhận
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill @(currentStatus == "Confirmed" ? "active bg-success" : "bg-white text-dark border")" asp-action="Index" asp-route-status="Confirmed">
            <i class="bi bi-check2-circle me-1"></i>Đã xác nhận
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill @(currentStatus == "CheckedIn" ? "active bg-primary" : "bg-white text-dark border")" asp-action="Index" asp-route-status="CheckedIn">
            <i class="bi bi-door-open-fill me-1"></i>Đang ở (Checked In)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill @(currentStatus == "CheckedOut" ? "active bg-secondary" : "bg-white text-dark border")" asp-action="Index" asp-route-status="CheckedOut">
            <i class="bi bi-check-all me-1"></i>Đã trả phòng
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-pill @(currentStatus == "Cancelled" ? "active bg-danger" : "bg-white text-dark border")" asp-action="Index" asp-route-status="Cancelled">
            <i class="bi bi-x-circle me-1"></i>Đã hủy
        </a>
    </li>
</ul>

<!-- Search Bar -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <input type="hidden" name="status" value="@currentStatus" />

        <div class="col-md-5">
            <label class="form-label small fw-bold text-muted">Tìm kiếm (Mã đơn, Tên khách, SĐT, Email)</label>
            <input type="text" name="search" class="form-control form-control-sm" placeholder="Nhập từ khóa..." value="@ViewBag.Search" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold text-muted">Từ ngày nhận phòng</label>
            <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold text-muted">Đến ngày nhận phòng</label>
            <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" />
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-emerald btn-sm w-100 fw-bold" title="Lọc">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Mã Đặt Phòng</th>
                    <th>Khách Hàng</th>
                    <th>Khách Sạn &amp; Phòng</th>
                    <th>Lịch Lưu Trú</th>
                    <th class="text-end">Tổng Tiền</th>
                    <th class="text-center">Thanh Toán</th>
                    <th class="text-center">Trạng Thái</th>
                    <th class="text-center" style="width: 140px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Không có đơn đặt phòng nào phù hợp với bộ lọc hiện tại.
                        </td>
                    </tr>
                }
                @foreach (var b in Model)
                {
                    <tr>
                        <td>
                            <strong class="text-emerald">@b.BookingCode</strong>
                            <div class="small text-muted" style="font-size: 11px;">@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@b.CustomerName</div>
                            <div class="small text-muted">@b.CustomerPhone</div>
                        </td>
                        <td>
                            <div class="small fw-semibold text-dark">@b.Room?.Hotel?.Name</div>
                            <div class="small text-muted">Phòng @b.Room?.RoomNumber (@b.Room?.RoomType?.Name)</div>
                        </td>
                        <td>
                            <div class="small">
                                <strong>@b.CheckInDate.ToString("dd/MM/yyyy")</strong> &rarr; <strong>@b.CheckOutDate.ToString("dd/MM/yyyy")</strong>
                                <span class="badge bg-light text-dark border">@b.TotalNights đêm</span>
                            </div>
                        </td>
                        <td class="text-end fw-bold text-dark">
                            @b.TotalAmount.ToString("N0") đ
                        </td>
                        <td class="text-center">
                            @if (b.PaymentStatus == PaymentStatus.Paid)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill small">
                                    <i class="bi bi-check-circle me-1"></i>Đã thanh toán
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-2 py-1 rounded-pill small">
                                    <i class="bi bi-clock me-1"></i>Chưa thanh toán
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            @switch (b.Status)
                            {
                                case BookingStatus.Pending:
                                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill">Chờ duyệt</span>
                                    break;
                                case BookingStatus.Confirmed:
                                    <span class="badge bg-success px-3 py-1 rounded-pill">Đã xác nhận</span>
                                    break;
                                case BookingStatus.CheckedIn:
                                    <span class="badge bg-primary px-3 py-1 rounded-pill">Đang ở</span>
                                    break;
                                case BookingStatus.CheckedOut:
                                    <span class="badge bg-secondary px-3 py-1 rounded-pill">Đã trả phòng</span>
                                    break;
                                case BookingStatus.Cancelled:
                                    <span class="badge bg-danger px-3 py-1 rounded-pill">Đã hủy</span>
                                    break;
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group">
                                <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-outline-dark btn-sm rounded-pill px-3" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
