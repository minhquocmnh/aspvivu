<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Trị Khách Sạn &amp; Homestay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light">
    <!-- Top Bar -->
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-2 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-5 fw-bold text-success d-flex align-items-center gap-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-buildings-fill text-emerald"></i>
            <span>StayVivu <span class="badge bg-success-subtle text-success fs-6 fw-normal">Host Admin</span></span>
        </a>
        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#adminSidebarMenu" aria-controls="adminSidebarMenu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-nav flex-row ms-auto me-3 align-items-center gap-3">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill" target="_blank">
                <i class="bi bi-box-arrow-up-right me-1"></i>Xem trang khách hàng
            </a>
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="avatar-circle bg-success text-white me-2">
                        <i class="bi bi-person-fill"></i>
                    </span>
                    <strong class="d-none d-sm-inline">@(User.FindFirst("FullName")?.Value ?? User.Identity?.Name)</strong>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="dropdownUser">
                    <li><span class="dropdown-header">Chủ khách sạn / Admin</span></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger rounded-2">
                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav id="adminSidebarMenu" class="col-md-3 col-lg-2 d-md-block admin-sidebar collapse px-3 py-3">
                <div class="position-sticky pt-2">
                    <div class="text-uppercase small fw-bold text-muted px-3 mb-2">Thống kê &amp; Vận hành</div>
                    <ul class="nav flex-column mb-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2 me-2 text-warning"></i>Tổng quan Doanh thu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Rooms" asp-action="Rack">
                                <i class="bi bi-grid-3x3-gap-fill me-2 text-info"></i>Sơ đồ phòng trực quan
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Bookings" asp-action="Index">
                                <i class="bi bi-calendar2-check-fill me-2 text-success"></i>Đơn đặt phòng
                            </a>
                        </li>
                    </ul>

                    <div class="text-uppercase small fw-bold text-muted px-3 mb-2">Quản lý Khách sạn</div>
                    <ul class="nav flex-column mb-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Rooms" asp-action="Index">
                                <i class="bi bi-door-closed me-2 text-primary"></i>Danh sách số phòng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Rooms" asp-action="RoomTypes">
                                <i class="bi bi-card-heading me-2 text-danger"></i>Loại phòng &amp; Giá
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Services" asp-action="Index">
                                <i class="bi bi-stars me-2 text-warning"></i>Dịch vụ đi kèm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Hotels" asp-action="Index">
                                <i class="bi bi-building me-2 text-info"></i>Cơ sở Homestay / KS
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content Area -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center rounded-3 shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                        <div>@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center rounded-3 shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                        <div>@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
