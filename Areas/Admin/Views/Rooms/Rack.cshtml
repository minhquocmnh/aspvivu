@model HotelBookingSystem.Models.ViewModels.RoomRackViewModel
@{
    ViewData["Title"] = "Sơ Đồ Phòng Trực Quan (Room Rack) - " + Model.TargetDate.ToString("dd/MM/yyyy");
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-grid-3x3-gap-fill text-emerald me-2"></i>Sơ Đồ Trạng Thái Phòng Thời Gian Thực
        </h1>
        <p class="text-muted small mb-0">Theo dõi trạng thái từng buồng phòng theo ngày, hỗ trợ kiểm soát nhận/trả phòng nhanh chóng</p>
    </div>

    <!-- Date selector -->
    <form asp-action="Rack" method="get" class="d-flex align-items-center gap-2">
        <label class="small fw-bold text-muted text-nowrap">Chọn ngày xem:</label>
        <input type="date" name="date" class="form-control form-control-sm" value="@Model.TargetDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
        <a asp-action="Rack" class="btn btn-outline-secondary btn-sm text-nowrap">Hôm nay</a>
    </form>
</div>

<!-- Legend Bar -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <div class="d-flex flex-wrap gap-4 align-items-center small">
        <span class="fw-bold text-muted">Chú thích trạng thái:</span>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success p-2 rounded-circle" style="width: 14px; height: 14px;"></span>
            <span>Phòng Trống (Sẵn sàng)</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-danger p-2 rounded-circle" style="width: 14px; height: 14px;"></span>
            <span>Đang Có Khách Ở (Checked In)</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-warning p-2 rounded-circle" style="width: 14px; height: 14px;"></span>
            <span>Đã Được Đặt Trước (Confirmed)</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-secondary p-2 rounded-circle" style="width: 14px; height: 14px;"></span>
            <span>Đang Bảo Trì / Sửa Chữa</span>
        </div>
    </div>
</div>

<!-- Group rooms by Hotel -->
@{
    var groupedByHotel = Model.Rooms.GroupBy(r => r.HotelName);
}

@foreach (var hotelGroup in groupedByHotel)
{
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-building text-emerald me-2"></i>@hotelGroup.Key
            </h5>
            <span class="badge bg-light text-dark border">@hotelGroup.Count() phòng</span>
        </div>

        <div class="row g-3">
            @foreach (var room in hotelGroup)
            {
                <div class="col-sm-6 col-md-4 col-lg-3 col-xl-2">
                    <div class="card h-100 rack-card border-@room.StatusColorClass">
                        <div class="card-header bg-@room.StatusColorClass text-white py-2 px-3 d-flex justify-content-between align-items-center">
                            <strong class="fs-6">Phòng @room.RoomNumber</strong>
                            <span class="badge bg-dark bg-opacity-50 small">Tầng @room.Floor</span>
                        </div>
                        <div class="card-body p-2 d-flex flex-column justify-content-between small">
                            <div>
                                <div class="fw-bold text-dark text-truncate" title="@room.RoomTypeName">@room.RoomTypeName</div>
                                <div class="text-muted" style="font-size: 11px;">@room.BasePrice.ToString("N0") đ/đêm</div>
                                <div class="mt-2 text-@room.StatusColorClass fw-semibold" style="font-size: 11px;">
                                    @room.CurrentStatusText
                                </div>
                            </div>

                            <div class="mt-2 pt-2 border-top d-flex gap-1 justify-content-between">
                                @if (room.CurrentBooking != null)
                                {
                                    <a asp-area="Admin" asp-controller="Bookings" asp-action="Details" asp-route-id="@room.CurrentBooking.Id" class="btn btn-outline-dark btn-sm w-100 py-0" style="font-size: 11px;">
                                        Xem đơn
                                    </a>
                                }
                                else
                                {
                                    <form asp-action="ChangeStatus" method="post" class="w-100">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@room.RoomId" />
                                        @if (room.SystemStatus == RoomStatus.Available)
                                        {
                                            <input type="hidden" name="status" value="@RoomStatus.Maintenance" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm w-100 py-0" style="font-size: 10px;" title="Chuyển sang bảo trì">
                                                Bảo trì
                                            </button>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="status" value="@RoomStatus.Available" />
                                            <button type="submit" class="btn btn-outline-success btn-sm w-100 py-0" style="font-size: 10px;" title="Mở lại phòng đón khách">
                                                Mở phòng
                                            </button>
                                        }
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
