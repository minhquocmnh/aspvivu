@model List<HotelBookingSystem.Models.ExtraService>
@{
    ViewData["Title"] = "Quản Lý Dịch Vụ Đi Kèm";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-stars text-warning me-2"></i>Quản Lý Dịch Vụ Đi Kèm (Add-on Services)
        </h1>
        <p class="text-muted small mb-0">Cấu hình các gói dịch vụ tiện ích khách có thể chọn thêm khi đặt phòng</p>
    </div>
    <div class="btn-toolbar gap-2">
        <a asp-action="Create" class="btn btn-emerald btn-sm rounded-pill px-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i>Thêm Dịch Vụ Mới
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th style="width: 70px;">Icon</th>
                    <th>Tên Dịch Vụ</th>
                    <th>Mô Tả Tiện Ích</th>
                    <th class="text-end" style="width: 160px;">Đơn Giá</th>
                    <th class="text-center" style="width: 140px;">Đơn Vị Tính</th>
                    <th class="text-center" style="width: 140px;">Trạng Thái</th>
                    <th class="text-center" style="width: 160px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="text-center">
                            <span class="avatar-circle bg-light text-emerald fs-5">
                                <i class="bi @s.Icon"></i>
                            </span>
                        </td>
                        <td>
                            <strong class="text-dark">@s.Name</strong>
                        </td>
                        <td class="small text-muted">
                            @s.Description
                        </td>
                        <td class="text-end fw-bold text-emerald">
                            @s.Price.ToString("N0") đ
                        </td>
                        <td class="text-center">
                            <span class="badge bg-light text-dark border">@s.Unit</span>
                        </td>
                        <td class="text-center">
                            @if (s.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">Đang áp dụng</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1 rounded-pill">Tạm ngừng</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group gap-1">
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-outline-primary btn-sm rounded-pill px-2" title="Chỉnh sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="ToggleActive" asp-route-id="@s.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-2" title="@(s.IsActive ? "Tắt dịch vụ" : "Bật dịch vụ")">
                                        <i class="bi @(s.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa dịch vụ này không?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
