@model HotelBookingSystem.Models.ExtraService
@{
    ViewData["Title"] = "Thêm Dịch Vụ Mới";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h4 class="fw-bold text-dark mb-3">
                <i class="bi bi-plus-circle text-emerald me-2"></i>Thêm Gói Dịch Vụ Đi Kèm Mới
            </h4>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label small fw-bold">Tên dịch vụ tiện ích *</label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Bữa sáng buffet đặc sản, Đưa đón xe riêng..." required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label small fw-bold">Đơn giá (VNĐ) *</label>
                        <input asp-for="Price" type="number" step="1000" class="form-control" placeholder="150000" required />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Unit" class="form-label small fw-bold">Đơn vị tính *</label>
                        <input asp-for="Unit" class="form-control" placeholder="người / ngày, chuyến, xe / ngày..." required />
                        <span asp-validation-for="Unit" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Icon" class="form-label small fw-bold">Biểu tượng (Bootstrap Icon class)</label>
                        <select asp-for="Icon" class="form-select">
                            <option value="bi-cup-hot">Bữa ăn / Nước uống (bi-cup-hot)</option>
                            <option value="bi-car-front">Xe đưa đón (bi-car-front)</option>
                            <option value="bi-bicycle">Xe máy / Xe đạp (bi-bicycle)</option>
                            <option value="bi-fire">BBQ / Lửa trại (bi-fire)</option>
                            <option value="bi-compass">Tour khám phá (bi-compass)</option>
                            <option value="bi-bag-check">Giặt là (bi-bag-check)</option>
                            <option value="bi-water">Hồ bơi / Chèo thuyền (bi-water)</option>
                            <option value="bi-stars">Khác / Tiện nghi (bi-stars)</option>
                        </select>
                    </div>

                    <div class="col-md-6 d-flex align-items-center pt-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" checked>
                            <label class="form-check-label fw-semibold" asp-for="IsActive">Kích hoạt áp dụng ngay</label>
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label small fw-bold">Mô tả dịch vụ</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Chi tiết về dịch vụ, thời gian phục vụ, cam kết chất lượng..."></textarea>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-emerald rounded-pill px-4 fw-bold">
                        <i class="bi bi-save me-1"></i>Lưu Dịch Vụ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
