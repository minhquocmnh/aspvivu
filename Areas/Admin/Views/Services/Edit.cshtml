@model HotelBookingSystem.Models.ExtraService
@{
    ViewData["Title"] = "Chỉnh Sửa Dịch Vụ - " + Model.Name;
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h4 class="fw-bold text-dark mb-3">
                <i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh Sửa Gói Dịch Vụ
            </h4>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label small fw-bold">Tên dịch vụ *</label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label small fw-bold">Đơn giá (VNĐ) *</label>
                        <input asp-for="Price" type="number" step="1000" class="form-control" required />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Unit" class="form-label small fw-bold">Đơn vị tính *</label>
                        <input asp-for="Unit" class="form-control" required />
                        <span asp-validation-for="Unit" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Icon" class="form-label small fw-bold">Biểu tượng</label>
                        <select asp-for="Icon" class="form-select">
                            <option value="bi-cup-hot">Bữa ăn / Nước uống (bi-cup-hot)</option>
                            <option value="bi-car-front">Xe đưa đón (bi-car-front)</option>
                            <option value="bi-bicycle">Xe máy / Xe đạp (bi-bicycle)</option>
                            <option value="bi-fire">BBQ / Lửa trại (bi-fire)</option>
                            <option value="bi-compass">Tour khám phá (bi-compass)</option>
                            <option value="bi-bag-check">Giặt là (bi-bag-check)</option>
                            <option value="bi-water">Hồ bơi / Chèo thuyền (bi-water)</option>
                            <option value="bi-stars">Khác / Tiện nghi (bi-stars)</option>
                        </select>
                    </div>

                    <div class="col-md-6 d-flex align-items-center pt-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive">
                            <label class="form-check-label fw-semibold" asp-for="IsActive">Kích hoạt áp dụng</label>
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label small fw-bold">Mô tả dịch vụ</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                        <i class="bi bi-check2-circle me-1"></i>Lưu Thay Đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
